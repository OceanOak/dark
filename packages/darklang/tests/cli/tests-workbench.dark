/// Navigation regressions that need real key dispatch and populated views.
module Darklang.Cli.Tests.TestSuite

// A move with History.Record leaves a way back and one with History.Skip (back's own) does
// not; the reader highlights what it is given only for Reader.Code.
test workbenchNavigationEnums =
  let base = workbenchState()
  let point =
    { (Darklang.Cli.Workbench.returnPointOf(base)) with
        view = Darklang.Cli.Workbench.vMatter }
  let recorded =
    Darklang.Cli.Workbench.moveToPoint(base, point, Darklang.Cli.Workbench.History.Record)
  let skipped =
    Darklang.Cli.Workbench.moveToPoint(base, point, Darklang.Cli.Workbench.History.Skip)
  let code =
    match Darklang.Cli.Workbench.openReader(base, "x", Darklang.Cli.Workbench.Reader.Code) with
    | Continue(s) -> Stdlib.Option.Option.Some(s.readingIsCode)
    | _ -> Stdlib.Option.Option.None
  let prose =
    match Darklang.Cli.Workbench.openReader(base, "x", Darklang.Cli.Workbench.Reader.Prose) with
    | Continue(s) -> Stdlib.Option.Option.Some(s.readingIsCode)
    | _ -> Stdlib.Option.Option.None

  Stdlib.Test.all(
    [ Stdlib.List.length(recorded.back) |> Stdlib.Test.equal(1)
      Stdlib.List.length(skipped.back) |> Stdlib.Test.equal(0)
      recorded.activeView |> Stdlib.Test.equal(Darklang.Cli.Workbench.vMatter)
      skipped.activeView |> Stdlib.Test.equal(Darklang.Cli.Workbench.vMatter)
      code |> Stdlib.Test.equal(Stdlib.Option.Option.Some(true))
      prose |> Stdlib.Test.equal(Stdlib.Option.Option.Some(false)) ])

test workbenchHistoryRoundTrip =
  let base = workbenchState()
  let hit = Darklang.Cli.Workbench.SearchHit
    { modules = [ "Darklang", "Stdlib", "List" ]
      name = "map", kind = "fn", display = "map" }
  let jumped =
    match Darklang.Cli.Workbench.jumpToHit(base, hit) with
    | Continue(s) -> s
    | _ -> base
  let returned = (wbKey(jumped, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let tree = (wbChar(base, "2")).state
  let original =
    { tree with filter = "Darklang", selected = 0
                items = Darklang.Cli.Workbench.applyFilter(tree.items, "Darklang") }
  let entered = (wbKey(original, Stdlib.Cli.Stdin.Key.Key.Enter)).state
  let parent = (wbKey(entered, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let lens = (wbChar(tree, "L")).state
  let beforeLens = (wbKey(lens, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let sameReturnPoint(
    a: Darklang.Cli.Workbench.State,
    b: Darklang.Cli.Workbench.State)
    : Bool =
    Darklang.Cli.Workbench.returnPointOf(a) == Darklang.Cli.Workbench.returnPointOf(b)
  if (Stdlib.List.length(jumped.back) == 1)
     && (sameReturnPoint(returned, base))
     && (Stdlib.List.isEmpty(returned.back))
     && (entered.location != original.location)
     && (sameReturnPoint(parent, original))
     && (parent.items == original.items)
     && (lens.matter.lens != tree.matter.lens)
     && (sameReturnPoint(beforeLens, tree))
  then Stdlib.Test.Result.Pass
  else Stdlib.Test.fail("search, modules and lenses must return in one Escape")

test workbenchBranchPicker =
  let base = workbenchState()
  let opened = (wbChar(base, "S")).state
  let opens = match opened.overlay with | Branches(_) -> true | _ -> false
  let choices =
    Stdlib.List.range(1, 20) |> Stdlib.List.map(fun n ->
      Darklang.Cli.Workbench.BranchChoice
        { id = Darklang.SCM.Branch.mainBranchId
          name = "branch-" + (Stdlib.display(n)), detail = "" })
  let picker = Darklang.Cli.Workbench.BranchPicker
    { choices = choices, field = Stdlib.Cli.UI.TextField.fromText(""), selected = 0 }
  let state = { base with overlay = Darklang.Cli.Workbench.Overlay.Branches(picker) }
  let paged = (wbKey(state, Stdlib.Cli.Stdin.Key.Key.PageDown)).state
  let typed = (wbChar(paged, "BRANCH-20")).state
  let matched =
    match typed.overlay with
    | Branches(p) ->
      let names =
        Darklang.Cli.Workbench.matchingBranches(p) |> Stdlib.List.map(fun b -> b.name)
      (p.selected == 0) && (names == [ "branch-20" ])
    | _ -> false
  let missing = (wbChar(typed, "zzz")).state
  let enter = (wbKey(missing, Stdlib.Cli.Stdin.Key.Key.Enter)).state
  let noMatch =
    match enter.overlay with
    | Branches(p) -> Stdlib.List.isEmpty(Darklang.Cli.Workbench.matchingBranches(p))
    | _ -> false
  let cancelled = (wbKey(typed, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let fromCode = (wbChar((wbChar(base, "2")).state, "S")).state
  let fromHome = (wbChar(base, "s")).state
  let isOpen(s: Darklang.Cli.Workbench.State): Bool =
    match s.overlay with | Branches(_) -> true | _ -> false
  if opens && matched && noMatch && (isOpen(fromCode)) && (isOpen(fromHome))
     && (cancelled.overlay == Darklang.Cli.Workbench.Overlay.NoOverlay)
     && (cancelled.branchId == base.branchId)
     && (cancelled.items == base.items)
  then Stdlib.Test.Result.Pass
  else Stdlib.Test.fail("picker must filter all branches, cancel and reject no matches")

// A first run lands on Home. While nothing is in progress, Home ends with where to begin, and
// each of those rows opens the view it names.
test workbenchHomeSaysWhereToBegin =
  let start = Darklang.Cli.Workbench.homeStartRows(true, 0, 0, 0)
  let kinds = start |> Stdlib.List.map(fun item -> item.kind)
  let gone =
    [ Darklang.Cli.Workbench.homeStartRows(false, 0, 0, 0)
      Darklang.Cli.Workbench.homeStartRows(true, 1, 0, 0)
      Darklang.Cli.Workbench.homeStartRows(true, 0, 1, 0)
      Darklang.Cli.Workbench.homeStartRows(true, 0, 0, 1) ]
    |> Stdlib.List.all(fun rows -> Stdlib.List.isEmpty(rows))
  let base = workbenchState()
  let opens(index: Int64): Int64 =
    let state = { base with items = start, selected = index }
    (wbKey(state, Stdlib.Cli.Stdin.Key.Key.Enter)).state.activeView
  let startsTour =
    let state = { base with items = start, selected = 0 }
    (wbKey(state, Stdlib.Cli.Stdin.Key.Key.Enter)).state.tour == Darklang.Cli.Workbench.tourAt(0)
  if (kinds == [ "home-start-tour", "home-start-repl", "home-start-code", "home-start-docs" ])
     && gone
     && startsTour
     && (opens(1) == Darklang.Cli.Workbench.vScratch)
     && (opens(2) == Darklang.Cli.Workbench.vMatter)
     && (opens(3) == Darklang.Cli.Workbench.vDocs)
  then Stdlib.Test.Result.Pass
  else Stdlib.Test.fail("Home must say where to begin while nothing is in progress, and open each view")


// The tour, walked with the real keys. It never takes the workbench's own keys, so you can
// explore mid-step; it moves only on `]` and `[`; a try-it is ticked when done but does not move
// on by itself; and `]` typed into the command bar is text, not "next".
test workbenchTourWalksThrough =
  let step(s: Darklang.Cli.Workbench.State): Int64 =
    match s.tour with
    | Some(t) -> t.step
    | None -> 0 - 1
  let done(s: Darklang.Cli.Workbench.State): Bool =
    match s.tour with
    | Some(t) -> t.done
    | None -> false
  let s0 = { (workbenchState()) with tour = Darklang.Cli.Workbench.tourAt(0) }
  // ⏎ and esc are the workbench's, not the tour's: neither moves nor ends it.
  let s0e = (wbKey(s0, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let s1 = (wbChar(s0e, "]")).state
  let back = (wbChar(s1, "[")).state
  let s2 = (wbChar(s1, "]")).state
  // "Press 2": doing it ticks the step, and the tour stays on it.
  let s2d = (wbChar(s2, "2")).state
  // Wander: open the nav and come back out. Still the same step, still ticked.
  let s2w = (wbKey((wbChar(s2d, "`")).state, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let s3 = (wbChar(s2w, "]")).state
  let s4 = (wbChar(s3, "]")).state
  let s4d = (wbChar(s4, "?")).state
  // The keymap is up: `]` closes it (any key does) instead of moving the tour.
  let s4c = (wbChar(s4d, "]")).state
  let s5 = (wbChar(s4c, "]")).state
  let s5d = (wbChar(s5, ":")).state
  // In the bar, `]` is a character you typed.
  let typedBracket = (wbChar(s5d, "]")).state
  let s6 = (wbChar((wbKey(s5d, Stdlib.Cli.Stdin.Key.Key.Escape)).state, "]")).state
  let s6open = (wbChar(s6, ":")).state
  let typed =
    [ "1", " ", "+", " ", "2" ]
    |> Stdlib.List.fold(s6open, fun(s, c) -> (wbChar(s, c)).state)
  let s6d = (wbKey(typed, Stdlib.Cli.Stdin.Key.Key.Enter)).state
  let s7 = (wbChar(s6d, "]")).state
  let finished = (wbChar(s7, "]")).state
  let hidden = (wbChar(s7, ".")).state
  let closed = (wbChar(s2, "X")).state
  if (step(s0e) == 0)
     && (step(s1) == 1)
     && (step(back) == 0)
     && (step(s2) == 2) && (Stdlib.Bool.not(done(s2)))
     && (s2d.activeView == Darklang.Cli.Workbench.vMatter)
     && (step(s2d) == 2) && done(s2d)
     && (step(s2w) == 2) && done(s2w)
     && (step(s3) == 3) && (Stdlib.Bool.not(done(s3)))
     && (s4d.overlay == Darklang.Cli.Workbench.Overlay.Keymap) && done(s4d)
     && (s4c.overlay == Darklang.Cli.Workbench.Overlay.NoOverlay) && (step(s4c) == 4)
     && (step(s5d) == 5) && done(s5d)
     && (step(typedBracket) == 5)
     && (step(s6) == 6)
     && (Stdlib.Option.isSome(s6d.reading)) && (step(s6d) == 6) && done(s6d)
     && (step(s7) == 7)
     && (finished.tour == Stdlib.Option.Option.None)
     && (match hidden.tour with
         | Some(t) -> t.hidden
         | None -> false)
     && (closed.tour == Stdlib.Option.Option.None)
  then Stdlib.Test.Result.Pass
  else Stdlib.Test.fail("The tour must move only on ] and [, tick try-its, and leave every other key alone")

// Every step's label draws, at the width the tour was written for and at a narrow one, and is
// gone while the keymap is up.
test workbenchTourLabelsRender =
  let base = workbenchState()
  let shows(s: Darklang.Cli.Workbench.State, width: Int64, text: String): Bool =
    let size = Stdlib.Cli.Tui.Size { width = width, height = 30 }
    (Darklang.Cli.Workbench.viewAtSize(s, size)).rows
    |> Stdlib.List.any(fun r -> Stdlib.String.contains(Stdlib.Cli.Tui.Text.stripSgr(r), text))
  let steps = Darklang.Cli.Workbench.tourSteps()
  let allDraw =
    steps
    |> Stdlib.List.indexedMap(fun(i, step) -> (i, step))
    |> Stdlib.List.all(fun pair ->
      let (i, step) = pair
      let s = { base with tour = Darklang.Cli.Workbench.tourAt(i) }
      (shows(s, 120, step.title)) && (shows(s, 80, step.title)))
  let underKeymap =
    { base with
        tour = Darklang.Cli.Workbench.tourAt(0)
        overlay = Darklang.Cli.Workbench.Overlay.Keymap }
  // Hidden, the label is a one-line pill that still says where you are.
  let tucked =
    { base with
        tour =
          Stdlib.Option.Option.Some(
            Darklang.Cli.Workbench.Tour { step = 2, done = false, hidden = true }) }
  if allDraw
     && (Stdlib.Bool.not(shows(underKeymap, 120, "Hi! This is the workbench.")))
     && (shows(tucked, 120, "Tour 3/8 · Getting around"))
     && (Stdlib.Bool.not(shows(tucked, 120, "These are the places you can go")))
  then Stdlib.Test.Result.Pass
  else Stdlib.Test.fail("Every tour label must draw, and step aside for another overlay")
